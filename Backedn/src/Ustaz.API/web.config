<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting (MonsterASP/siteasp.net). The SDK generates this file at publish time when the
  project does not supply one, and its default is stdoutLogEnabled="false" — which leaves an
  HTTP 500.30 with no readable cause anywhere on the server.

  ANCM writes the unhandled startup exception to .\logs\stdout_*.log just before the process
  exits, so this is the only way to diagnose a failed start on shared hosting where the Windows
  Event Log is not reachable. Set stdoutLogEnabled back to "false" once the deployment is
  healthy: the files are never rotated and grow without bound.

  processPath and arguments are rewritten by the SDK for the published runtime identifier.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
