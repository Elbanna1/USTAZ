{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(local);Database=UstazDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "https://localhost:7001",
    "Audience": "http://localhost:5173",
    "Key": "ustaz-development-only-signing-key-change-me-32chars",
    "AccessTokenMinutes": 120,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "PolicyName": "UstazClientPolicy",
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://127.0.0.1:5173"
    ]
  },
  "Seed": {
    "ApplyMigrationsOnStartup": true,
    "SeedEssentials": true,
    "SeedDemoData": true,
    "DemoPassword": "Demo@1234"
  },
  "Swagger": {
    "Enabled": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Storage": {
    "RootPath": "storage"
  },
  "Exams": {
    "ExpirySweepEnabled": true,
    "ExpirySweepSeconds": 60
  },
  "EarlyWarning": {
    "Enabled": false
  },
  "Email": {
    "Provider": "Gmail",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "EnableSsl": true,
    "Username": "support.webcraft.eg@gmail.com",
    "FromEmail": "support.webcraft.eg@gmail.com",
    "FromName": "Ustaz",
    "SupportEmail": "support.webcraft.eg@gmail.com",
    "ClientBaseUrl": "http://localhost:5173",
    "TimeoutInSeconds": 30,
    "MaxDeliveryAttempts": 3,
    "Enabled": true
  }
}
