    "Audience": "https://ustaz.app"
  },
  "Email": {
    "Provider": "Gmail",
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "EnableSsl": true,
    "Username": "support.webcraft.eg@gmail.com",
    "Password": "",
    "FromEmail": "support.webcraft.eg@gmail.com",
    "FromName": "Ustaz",
    "SupportEmail": "support.webcraft.eg@gmail.com",
    "ClientBaseUrl": "https://ustaz.app",
    "TimeoutInSeconds": 30,
    "MaxDeliveryAttempts": 3,
    "Enabled": true
  },
  "Storage": {
    "RootPath": "storage",
    "MaxFileSizeInMegabytes": 25
  },
  "Realtime": {
    "Enabled": true
  },
  "Exams": {
