{
  "//": "Production values come from the environment. Every entry here is either a safe default or an empty placeholder; no secret is ever committed. Set the secrets as environment variables: ConnectionStrings__DefaultConnection, Jwt__Key, Email__Password, Storage__RootPath, Cors__AllowedOrigins__0.",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
