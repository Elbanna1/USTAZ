# Copy to .env and fill in. Never commit .env.

# --- SQL Server (docker compose) -------------------------------------------
MSSQL_SA_PASSWORD=Change_this_Str0ng_Password!

# --- JWT --------------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_KEY=
JWT_ISSUER=https://api.ustaz.local
JWT_AUDIENCE=http://localhost:5173
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# --- API / client -----------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
CLIENT_ORIGIN=http://localhost:5173
SWAGGER_ENABLED=true

# --- First administrator (seeded only when both are set) --------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Demo data --------------------------------------------------------------
SEED_DEMO_DATA=false

# --- Cloudinary (optional; local disk storage is used when unset) -----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Gmail SMTP) -----------------------------------------------------
# The app password for support.webcraft.eg@gmail.com. Generate it at
#   https://myaccount.google.com/apppasswords  (2-Step Verification must be on).
# Never commit the real value: it belongs in .env here, in User Secrets locally,
# or in the deployment environment. Leave it empty and emails are written to
# {Storage:RootPath}/sent-emails instead of being sent.
EMAIL_PASSWORD=YOUR_GMAIL_APP_PASSWORD

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=support.webcraft.eg@gmail.com
EMAIL_FROM=support.webcraft.eg@gmail.com
EMAIL_FROM_NAME=Ustaz
EMAIL_SUPPORT=support.webcraft.eg@gmail.com

# --- Private file storage ---------------------------------------------------
# Homework files, message attachments and certificates. Inside compose this is a
# named volume; on a bare server point it at a mounted disk.
STORAGE_MAX_FILE_MB=25

# --- Live delivery and background passes ------------------------------------
# SignalR is in-box, so this needs no external service. Turn it off and the API
# still persists every notification; clients simply poll instead.
REALTIME_ENABLED=true

# Weekly early-warning notifications to guardians.
EARLY_WARNING_ENABLED=true
